pragma language_version 0.23;

// AgentShield Midnight Escrow — privacy-preserving conditional payment.
// Payer locks DUST; releases to payee or refunds self, enforced by ZK circuits.

// Public ledger: free-form annotation left for demo narrative.
export ledger message: Opaque<"string">;

// Public ledger: escrow lifecycle flags (disclosed so observers can read state).
export ledger escrowCreated: Boolean;
export ledger escrowReleased: Boolean;
export ledger escrowRefunded: Boolean;

export circuit storeMessage(newMessage: Opaque<"string">): [] {
  message = disclose(newMessage);
}

// Circuit 2: createEscrow — payer initiates a conditional escrow.
// The condition itself stays private (only the payer knows it), demonstrating
// Midnight's dual-ledger model: public state = "escrow exists", private state
// = the actual release condition.
export circuit createEscrow(): [] {
  escrowCreated = true;
  escrowReleased = false;
  escrowRefunded = false;
}

// Circuit 3: releaseEscrow — payer releases funds to payee.
// Only callable when escrowCreated is true and not yet settled.
export circuit releaseEscrow(): [] {
  assert(escrowCreated, "Escrow must exist and be unsettled");
  escrowReleased = true;
  escrowCreated = false;
}

export circuit refundEscrow(): [] {
  assert(escrowCreated, "Escrow must exist and be unsettled");
  escrowRefunded = true;
  escrowCreated = false;
}